    "def mse(t, y_pred):\n",
    "    return np.mean((t - y_pred) ** 2)\n",
    "\n",
    "def mae(t, y_pred):\n",
    "    return np.mean(np.abs(t - y_pred))\n",
    "\n",
    "def r2_score(t, y_pred):\n",
    "    t_mean = np.mean(t)\n",
    "    ss_total = np.sum((t - t_mean) ** 2)\n",
    "    ss_residual = np.sum((t - y_pred) ** 2)\n",
    "    return 1 - (ss_residual / ss_total)"
   ]
